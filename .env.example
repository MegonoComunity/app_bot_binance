# ─── Exchange Selection (BINANCE atau BITUNIX) ────────────────────────────────
ACTIVE_EXCHANGE=BITUNIX

# ─── Binance Credentials ──────────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ─── Bitunix Credentials ──────────────────────────────────────────────────────
BITUNIX_API_KEY=your_bitunix_api_key_here
BITUNIX_API_SECRET=your_bitunix_api_secret_here
BITUNIX_UID_USER=your_bitunix_uid_here
BITUNIX_BASE_URL=https://fapi.bitunix.com
# BITUNIX_PROXY=http://127.0.0.1:7890

# ─── Telegram Bot Credentials ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_chat_id
TELEGRAM_ERROR_CHAT_ID=your_error_chat_id
TELEGRAM_ADMIN_USER_IDS=your_chat_id
# Set False agar hasil simulasi / latihan demo tidak mengotori chat Telegram Admin
NOTIFY_SIMULATION_TRADES=False
# TELEGRAM_DEMO_CHAT_ID=your_demo_channel_or_group_id

# ─── Mode & Strategi Trading ─────────────────────────────────────────────────
TRADING_MODE=PAPER_TRADING
LEVERAGE=20
MARGIN_USDT=50
TP_PERCENT=40.0
SL_PERCENT=25.0
MAX_OPEN_POSITIONS=4

# ─── Scanner Settings ────────────────────────────────────────────────────────
SCAN_TARGET_COINS=ALL
SCAN_SORT_ORDER=VOLUME_DESC
EXCLUDED_COINS=BTCUSDT,ETHUSDT,XAUUSDT,PAXGUSDT,BTCDOMUSDT,USDCUSDT,FDUSDUSDT,TUSDUSDT,EURUSDT
SCAN_UNIVERSE_SIZE=80
TOP_N_COINS=80
SCAN_BATCH_SIZE=10
SCAN_INTERVAL_SECONDS=60
TIMEFRAME=5m
HTF_TIMEFRAME=1h
API_REQUEST_DELAY=0.5
SCANNER_MODE=per_coin

# ─── Risk Management & Proteksi Modal ────────────────────────────────────────
MARGIN_MODE=DYNAMIC
SIMULATED_MODAL=100.0
RISK_PER_TRADE_PERCENT=1.0
MAX_POSITION_EQUITY_RATIO=0.15
MAX_DAILY_LOSS_PERCENT=3.0
DAILY_LOSS_LIMIT_PERCENT=5.0
MAX_TOTAL_EXPOSURE_PERCENT=100.0
AUTO_CLOSE_PROFIT_HOURS=24
POSITION_MONITOR_INTERVAL=60

# ─── Auto Break-Even & Trailing Stop ──────────────────────────────────────────
USE_AUTO_BREAKEVEN=True
AUTO_BREAKEVEN_ROI_PERCENT=25.0
USE_TRAILING_STOP=False
TS_ACTIVATION_PERCENT=15.0
TS_CALLBACK_RATE=1.0

# ─── Adaptive Win Rate & Learner Gatekeeper ──────────────────────────────────
WINRATE_EVAL_WINDOW=DAILY
MIN_PATTERN_WINRATE=50.0
USE_PROBATION_MODE=True

# ─── Indikator & Confluence Settings ─────────────────────────────────────────
RSI_LENGTH=14
RSI_OVERSOLD=35
RSI_OVERBOUGHT=75
MIN_CONFLUENCE_SCORE=60.0
BREAKOUT_MIN_SCORE=50.0
BREAKOUT_VOLUME_MULTIPLIER=2.0
SMART_BUY_LOOKBACK_DAYS=20
SMART_BUY_TOLERANCE=0.005
ANALYSIS_LOOKBACK_DAYS=20
MIN_ORDER_BOOK_DEPTH_USDT=50000.0
MAX_FUNDING_RATE_PERCENT=0.05
ATR_MULTIPLIER_SL=1.5
LIMIT_ORDER_TIMEOUT_SECONDS=30

# ─── PostgreSQL Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/db_trade_bot
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=db_trade_bot

MARGIN_MODE='DYNAMIC'
SIMULATED_MODAL='0.0'
SCAN_TARGET_COINS='150'
SCAN_SORT_ORDER='VOLUME_DESC'
RISK_PER_TRADE_PERCENT='1.0'
MAX_POSITION_EQUITY_RATIO='0.15'
USE_AUTO_BREAKEVEN='True'
AUTO_BREAKEVEN_ROI_PERCENT='25.0'


